# Build artifacts
build/

# JP baseline cache (extracted by build.py from the JP ISO; consumed
# by tests + audit tools; regenerable; never committed)
cache/

# Layout QA reports — `reports` is a symlink to
# /home/ralf/romhack/lang3_layout_qa_history (its own git repo,
# sibling to lang3_local_docs/). Patterns cover both legacy plain-dir
# and current symlink.
reports
reports/
# Japanese disc image (user must provide their own)
*.iso
*.cue

# Compressed archives
*.zip

# PDFs (copyrighted guides)
*.pdf

# Python
__pycache__/
*.pyc
.pytest_cache/

# Legacy 0.2-patch extraction directory (replaced by patches/)
lang3a2/

# Generated/extracted font and data files (forensic, never committed)
patches/*_font.bin
patches/*_d00.dat

# EN-patched ISO script dumps (regenerated by tools/dump_en_scripts.py)
scripts/wip/

# Working files and internal docs (archive/ is a symlink to ~/romhack/lang3_local_docs/).
# Note: docs/ is tracked (public usage docs for fork authors / agents /
# frontend / contributors). Only the named legacy files below stay
# ignored.
claude_tasks_ec/
archive
CLAUDE.md
!scripts/ralph/CLAUDE.md
AGENTS.md
CLAUDE_TODO*.md
todo.md
measure.py
d00_size_report.md
FONT_TILE_REFERENCE.md

# Generated agent-consumption JSON pairs (regenerated by tools/dump_jp_en_pairs.py).
# Tracked exceptions: data/fonts/ holds third-party font sources;
# data/jp/tile_map.json is the JP char→tile authoring map used by the
# fnt_sys encoder (small, derivable but tedious to recompute).
data/*
!data/fonts/
!data/jp/
data/jp/*
!data/jp/tile_map.json

translation_analysis/

# Opening FMV: encoded CPK is a large regenerable asset, not committed
assets/movie/*.CPK
assets/movie/*.cpk
